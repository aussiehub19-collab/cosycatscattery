# ZOHO_SMTP_USER / ZOHO_SMTP_PASSWORD: Zoho Mail account used to send and
# receive Contact form and Order/checkout emails (app/api/contact/route.ts,
# app/api/order/route.ts, via lib/mailer.ts). ZOHO_SMTP_PASSWORD must be a
# Zoho "Application-Specific Password" (Zoho Mail -> Security -> App
# Passwords), never the account's actual login password. Both are read
# server-side only — never exposed to the browser bundle. Set these in
# Vercel Project Settings -> Environment Variables, then redeploy.
ZOHO_SMTP_USER=concierge@cosycatscattery.com.au
ZOHO_SMTP_PASSWORD=

# NEXT_PUBLIC_WEB3FORMS_KEY: Web3Forms access key used by the Wholesale form
# only (src/config/site.js -> FORMS.web3formsKey). Web3Forms access keys are
# public-by-design (they only authorize submissions to your inbox), so
# NEXT_PUBLIC_ exposure to the browser bundle is expected. Get a free key at
# https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_KEY=

# NEXT_PUBLIC_TURNSTILE_SITE_KEY: Optional Cloudflare Turnstile site key for
# spam protection on the forms above. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# RESEND_FROM / RESEND_API_KEY: Only needed if FORMS.provider is switched to
# 'resend' in src/config/site.js — requires a verified sending domain.
# RESEND_FROM=
# RESEND_API_KEY=
