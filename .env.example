# NEXT_PUBLIC_WEB3FORMS_KEY: Web3Forms access key used by the Contact, Cart
# checkout, and Wholesale forms (src/config/site.js -> FORMS.web3formsKey).
# Web3Forms access keys are public-by-design (they only authorize submissions
# to your inbox), so NEXT_PUBLIC_ exposure to the browser bundle is expected.
# Get a free key at https://web3forms.com — set this in Vercel Project
# Settings -> Environment Variables, then redeploy.
NEXT_PUBLIC_WEB3FORMS_KEY=

# NEXT_PUBLIC_TURNSTILE_SITE_KEY: Optional Cloudflare Turnstile site key for
# spam protection on the forms above. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# RESEND_FROM / RESEND_API_KEY: Only needed if FORMS.provider is switched to
# 'resend' in src/config/site.js — requires a verified sending domain.
# RESEND_FROM=
# RESEND_API_KEY=
